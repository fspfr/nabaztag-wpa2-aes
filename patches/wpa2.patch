+/*
+ * Parse decrypted WPA2 key data and install the GTK.
+ * Returns 0 on success.
+ * Handles: GTK KDE (id 221, OUI 00:0F:AC, type 1), and detects the
+ * group cipher from an RSNE (id 48) if present (default TKIP).
+ */
+static int wpa2_process_key_data(uint8_t *kd, uint16_t kd_len, uint8_t keyidx)
+{
+	uint16_t pos = 0;
+	int have_gtk = 0;
+	uint8_t group_ccmp = 0;
+
+	while((pos + 2) <= kd_len) {
+		uint8_t id = kd[pos];
+		uint8_t len = kd[pos+1];
+		if(pos + 2 + (uint16_t)len > kd_len)
+			break;
+		if(id == 48 && len >= 4) {
+			/* RSNE: version(2) then group cipher OUI+type */
+			if(kd[pos+6] == 0x04)
+				group_ccmp = 1;
+		} else if(id == 221 && len >= 8 &&
+			   kd[pos+2] == 0x00 && kd[pos+3] == 0x0f &&
+			   kd[pos+4] == 0xac && kd[pos+5] == 0x01) {
+			/* GTK KDE: 2-byte key info then GTK (maybe 2-byte pad) */
+			uint8_t copied = len - 6;
+			if(copied > EAPOL_MICK_LENGTH+EAPOL_EK_LENGTH)
+				copied = EAPOL_MICK_LENGTH+EAPOL_EK_LENGTH;
+			memcpy(gtk, &kd[pos+8], copied);
+			if(!(kd[pos+6] & 0x08)) {
+				/* RSC bit not set: last 2 bytes are padding */
+				if(copied > 32) copied = 32;
+				else if(copied > 16) copied = 16;
+			}
+			have_gtk = 1;
+			keyidx = kd[pos+6] & 0x03;
+		}
+		pos += 2 + len;
+	}
