+/*
+ * Compute/verify the EAPOL key MIC for the current mode.
+ * WPA1: HMAC-MD5 with the KCK (first 16 bytes of PTK).
+ * WPA2: HMAC-SHA1 with the KCK, truncated to 16 bytes.
+ */
+static void eapol_mic(const uint8_t *data, uint32_t len, uint8_t *mic16)
+{
+	if(wpa2_active()) {
+		uint8_t mic[20];
+		hmac_sha1(ptk, EAPOL_MICK_LENGTH, data, len, mic);
+		memcpy(mic16, mic, EAPOL_KEYMIC_LENGTH);
+	} else {
+		hmac_md5(ptk, EAPOL_MICK_LENGTH, data, len, mic16);
+	}
